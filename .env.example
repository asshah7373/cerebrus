# Cerebrus AI Pentesting Tool - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI Provider Configuration (Required for AI features)
# =============================================================================

# Anthropic API Key (recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Default AI model
DEFAULT_MODEL=claude-sonnet-4-20250514

# =============================================================================
# Database Configuration
# =============================================================================

# SQLite database URL (local storage)
DATABASE_URL=sqlite+aiosqlite:///./data/cerebrus.db

# =============================================================================
# Server Configuration
# =============================================================================

# Host and port for the API server
HOST=127.0.0.1
PORT=8000

# Enable debug mode (set to false in production)
DEBUG=true

# =============================================================================
# Security Configuration
# =============================================================================

# Automation level: manual, semi_auto, full_auto
AUTOMATION_LEVEL=semi_auto

# Maximum risk level for automatic execution: low, medium, high, critical
MAX_RISK_AUTO=low

# Require explicit authorization for all targets
REQUIRE_AUTHORIZATION=true

# =============================================================================
# Performance Configuration
# =============================================================================

# Maximum number of concurrent scans
MAX_CONCURRENT_SCANS=5

# Delay between requests in milliseconds
REQUEST_DELAY_MS=100

# =============================================================================
# Memory System Configuration
# =============================================================================

# Enable the knowledge graph memory system
ENABLE_MEMORY=true

# Memory retention in days
MEMORY_RETENTION_DAYS=30

# Maximum memory nodes
MAX_MEMORY_NODES=10000

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file paths
LOG_FILE=logs/cerebrus.log
AUDIT_LOG_FILE=logs/audit.log

# =============================================================================
# Tool Paths (Kali Linux defaults)
# =============================================================================

# Override if tools are installed in different locations
NMAP_PATH=/usr/bin/nmap
HYDRA_PATH=/usr/bin/hydra
NIKTO_PATH=/usr/bin/nikto
SQLMAP_PATH=/usr/bin/sqlmap
GOBUSTER_PATH=/usr/bin/gobuster
