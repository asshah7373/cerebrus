# Cerebrus .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
frontend/dist/
frontend/build/
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local
*.env

# Database
*.db
*.sqlite
*.sqlite3
data/*.db

# Logs
logs/
*.log

# Reports and exports
reports/
exports/

# OS
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# Security - never commit these
*.pem
*.key
*.crt
credentials.json
secrets.json

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Docker
.docker/
